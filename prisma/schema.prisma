// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // local Postgres for development
  // url      = env("POSTGRES_PRISMA_URL") // uses connection pooling (Vercel/Neon prod)
  // directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection (Vercel/Neon prod)
}

enum Gender {
  Male
  Female
}

enum UserRole {
  Owner
  SuperAdmin
  Admin
  Member
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  branch        String?
  phone         String?
  role          UserRole @default(Member)
  profilePic    String?
  gender        Gender?
  token         String?
  password_salt String
  password_hash String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "users")
}

enum MembershipLevel {
  Platinum
  Diamond
  Gold
  Silver
  Bronze
  Standard
}

enum ContributionSystem {
  Monthly
  Quarterly
  Yearly
}

enum MembershipType {
  Individual
  Company
}

enum PaymentMeans {
  Office
  Kebele
  Bank
  Edir
  Personal
  Other
}

enum EducationLevel {
  PHD
  Masters
  Degree
  Associate_Degree
  Diploma
  Certificate
  High_School
  Middle_Elementary_School
  Other
}

model Member {
  id                 String             @id @default(uuid())
  memberId           String             @unique
  phone              String             @unique
  email              String?
  membershipLevel    MembershipLevel    @default(Silver)
  contributionAmount Int
  contributionSystem ContributionSystem @default(Monthly)
  lastPaidAt         DateTime
  nextDueDate        DateTime
  hasPaid            Boolean
  membershipType     MembershipType
  positionAtWork     String?
  paymentMeans       PaymentMeans

  country     String?
  nationality String?

  password_salt String
  password_hash String

  region       String
  zone         String
  city         String
  kebele       String?
  registeredBy String? //admin id that registred this member or null

  // individual only
  firstName      String?
  lastName       String?
  gender         Gender?
  educationLevel EducationLevel?
  expertise      String?
  dateOfBirth    String?
  workPlace      String?
  profileImage   String?
  branch         String?
  idNumber       String?

  // company only
  institutionName      String?
  headOrRepresentative String?
  fieldOfWork          String?
  partnershipIdea      String?

  idRenewedYear Int? // Ethiopian calendar year the membership ID was last renewed for
  idRenewedAt   DateTime? // Gregorian timestamp of that renewal, for audit purposes

  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  contributions Contribution[]

  @@map(name: "members")
}

model TempMember {
  id                 String             @id @default(uuid())
  phone              String
  email              String?
  membershipLevel    MembershipLevel    @default(Silver)
  contributionAmount Int
  contributionSystem ContributionSystem @default(Monthly)
  lastPaidAt         DateTime
  nextDueDate        DateTime
  hasPaid            Boolean
  membershipType     MembershipType
  positionAtWork     String?
  paymentMeans       PaymentMeans

  password_salt String
  password_hash String

  country     String?
  nationality String?

  region       String
  zone         String
  city         String
  kebele       String?
  registeredBy String? //admin id that registred this member or null

  // individual only
  firstName      String?
  lastName       String?
  gender         Gender?
  educationLevel EducationLevel?
  expertise      String?
  dateOfBirth    String?
  workPlace      String?
  profileImage   String?
  branch         String?
  idNumber       String?

  // company only
  institutionName      String?
  headOrRepresentative String?
  fieldOfWork          String?
  partnershipIdea      String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "temp_members")
}

model SmsMessage {
  id          String @id @default(uuid())
  message     String
  totalPhones Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "sms_message")
}

model Contribution {
  id                 String             @id @default(uuid())
  contributionSystem ContributionSystem
  contributorId      String
  contributor        Member             @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  amount             Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "contribution")
}

model GeneralDonation {
  id                  String  @id @default(uuid())
  fullName            String
  phone               String
  donationDesignation String
  paymentMethod       String?
  amount              Int
  branch              String?

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "general-donation")
}

model ContactUs {
  id       Int     @id @default(autoincrement())
  fullName String
  email    String
  message  String
  phone    String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Subscriber {
  id    Int    @id @default(autoincrement())
  email String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model News {
  id              String   @id @default(uuid())
  headline        String
  headlineAmharic String
  profileImage    String[]
  body            String
  bodyAmharic     String
  youtubeLink     String?
  isDraft         Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "news")
}

model Event {
  id              String  @id @default(uuid())
  headline        String
  headlineAmharic String
  profileImage    String
  body            String
  bodyAmharic     String
  isDraft         Boolean @default(false)

  startDate DateTime
  endDate   DateTime

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "event")
}

model Campaign {
  id                 String  @id @default(uuid())
  headline           String
  headlineAmharic    String
  description        String
  descriptionAmharic String  @default("")
  image              String?
  youtubeLink        String?
  goalAmount         Int?
  raisedAmount       Int?    @default(0)
  isFeatured         Boolean @default(false)
  isDraft            Boolean @default(false)

  startDate DateTime
  endDate   DateTime

  created_at DateTime          @default(now())
  updated_at DateTime          @default(now()) @updatedAt
  donations  GeneralDonation[]

  @@map(name: "campaign")
}

model Resource {
  id          String  @id @default(uuid())
  name        String
  description String
  document    String
  isDraft     Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "resource")
}

model Initiative {
  id                      String   @id @default(uuid())
  nameOfInitiative        String
  nameOfInitiativeAmharic String
  featuredImages          String[]
  body                    String
  bodyAmharic             String
  youtubeLink             String?
  isDraft                 Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "initiative")
}

model Management {
  id                 String  @id @default(uuid())
  managerName        String
  managerNameAmharic String
  photo              String
  job                String
  jobAmharic         String
  bio                String
  bioAmharic         String
  isDraft            Boolean @default(false)
  isBoardMember      Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "management")
}

model Partnership {
  id                 String  @id @default(uuid())
  partnerName        String
  partnerNameAmharic String
  logo               String
  bio                String
  bioAmharic         String
  isDraft            Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "partnership")
}

model Job {
  id                    String   @id @default(uuid())
  jobTitle              String
  jobTitleAmharic       String
  jobDescription        String
  jobDescriptionAmharic String
  document              String
  deadlineDate          DateTime

  isDraft Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "job")
}

model Faq {
  id              String  @id @default(uuid())
  question        String
  questionAmharic String  @default("")
  answer          String
  answerAmharic   String  @default("")
  isDraft         Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "faq")
}

model AboutContent {
  id              String   @id @default(uuid())
  section         String   @unique
  title           String   @default("")
  titleAmharic    String   @default("")
  subtitle        String   @default("")
  subtitleAmharic String   @default("")
  body            String   @default("")
  bodyAmharic     String   @default("")
  items           String[] @default([])
  itemsAmharic    String[] @default([])
  image           String?
  isDraft         Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "about_content")
}

model Auction {
  id           String   @id @default(uuid())
  title        String
  description  String
  CPO          Int
  formPayment  Int
  formFile     String
  isPurchasing Boolean
  startDate    DateTime
  endDate      DateTime
  Bidder       Bidder[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "auction")
}

model Bidder {
  id          String  @id @default(uuid())
  memberId    String
  fullName    String
  message     String?
  offer       Int
  filledForm  String?
  auctionId   String
  auction     Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  hasPaidCPO  Boolean @default(false)
  hasPaidNRP  Boolean @default(false)
  isSubmitted Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "bidder")
}
