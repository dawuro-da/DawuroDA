// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
}

enum UserRole {
  SuperAdmin //this means owner
  Admin
  Member
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  userName      String
  email         String   @unique
  phone         String?  @unique
  role          UserRole @default(Member)
  gender        Gender?
  isApproved    Boolean
  approvedBy    String?
  password_salt String
  password_hash String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "users")
}

enum MembershipLevel {
  Platinium
  Diamond
  Gold
  Siliver
  Bronze
  Standard
}

enum ContributionSystem {
  Monthly
  Quarterly
  Yearly
}

enum MembershipType {
  Individual
  Company
}

enum PaymentMeans {
  Office
  Kebele
  Bank
  Edir
  Personal
  Other
}

model Member {
  id                 String             @id @default(uuid())
  memberId           String             @unique
  phone              String             @unique
  email              String?            @unique
  membershipLevel    MembershipLevel    @default(Siliver)
  contributionAmount Int
  contributionSystem ContributionSystem @default(Monthly)
  lastPaidAt         DateTime
  nextDueDate        DateTime
  hasPaid            Boolean
  membershipType     MembershipType
  positionAtWork     String?
  paymentMeans       PaymentMeans

  password_salt String
  password_hash String

  region       String
  zone         String
  city         String
  kebele       String?
  registeredBy String? //admin id that registred this member or null

  // individual only
  firstName      String?
  lastName       String?
  gender         Gender?
  educationLevel String?
  expertise      String?
  dateOfBirth    String?
  workPlace      String?
  profileImage   String?
  branch         String?
  idNumber       String?

  // company only
  institutionName      String?
  headOrRepresentative String?
  fieldOfWork          String?
  partnershipIdea      String?

  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  contributions Contribution[]

  @@map(name: "members")
}

model Contribution {
  id                 String             @id @default(uuid())
  contributionSystem ContributionSystem
  contributorId      String
  contributor        Member             @relation(fields: [contributorId], references: [id])
  amount             String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "contribution")
}

model GeneralDonation {
  id                  String  @id @default(uuid())
  fullName            String
  phone               String
  donationDesignation String
  paymentMethod       String?
  amount              String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map(name: "general-donation")
}

model ContactUs {
  id       Int     @id @default(autoincrement())
  fullName String
  email    String
  message  String
  phone    String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}

model Subscriber {
  id    Int    @id @default(autoincrement())
  email String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}
